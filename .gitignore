# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment (NUNCA commitar chaves secretas!)
.env
.env.*
!.env.example
# .env.production contém APENAS a URL e a anon key do Supabase, que são
# públicas por design (o acesso é controlado por RLS). Precisa ser versionado
# porque o Vite injeta essas variáveis em build time, no CI do Cloudflare.
!.env.production

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Supabase
supabase/.temp/
supabase/.branches/

