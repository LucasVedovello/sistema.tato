# ============================================================
# CV Produções Artísticas — variáveis de ambiente
# Copie para .env e preencha com os valores reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# URL do projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon) — segura para uso no frontend
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ------------------------------------------------------------
# ATENÇÃO: a service_role key ignora RLS e tem acesso TOTAL ao
# banco. Use SOMENTE em scripts server-side / CLI.
# NÃO use o prefixo VITE_ nela (isso a exporia no bundle do cliente).
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
